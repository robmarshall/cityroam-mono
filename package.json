{
  "name": "city-roam-v2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "run-p dev:*",
    "dev:marketing": "npm -w @cityroam/marketing run dev",
    "dev:app": "npm -w @cityroam/app run dev",
    "dev:api": "npm -w @cityroam/api run dev",
    "dev:admin": "npm -w @cityroam/admin run dev",
    "build": "npm -ws --if-present run build",
    "test": "npm -ws --if-present run test",
    "typecheck": "npm -ws --if-present run typecheck",
    "loop": "bash run.sh",
    "loop:plan": "bash run.sh plan",
    "docker:build": "docker compose up -d --build",
    "docker:shell": "docker compose exec dev bash",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all2": "^7.0.2",
    "typescript": "^5.7.3"
  }
}
