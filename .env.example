# ===========================================================================
# City Roam v2 — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in real values before running.
# Variables marked (optional) have sensible defaults or are only needed
# for specific features.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
BASE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Deployment (Coolify / docker-compose.prod.yml + docker-compose.staging.yml)
# ---------------------------------------------------------------------------
# These build the Traefik routing rules. Compose interpolates the required ones
# with `:?`, so an unset value aborts the deploy instead of producing an empty
# Host() rule that silently 404s.
#
# docker-compose.prod.yml (required):
# DOMAIN=cityroam.co.uk
# API_DOMAIN=api.cityroam.co.uk
# ADMIN_DOMAIN=admin.cityroam.co.uk
# POSTGRES_PASSWORD=change-me-in-production
#
# docker-compose.staging.yml (required — backend only, frontends are on Vercel):
# API_DOMAIN=api-staging.cityroam.co.uk
# WS_DOMAIN=ws-staging.cityroam.co.uk
# POSTGRES_PASSWORD=change-me-in-staging
# REDIS_PASSWORD=change-me-in-staging
#
# Optional (defaults shown):
# POSTGRES_USER=cityroam
# POSTGRES_DB=cityroam
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# BUILD-TIME variables (read this before deploying a frontend)
# ---------------------------------------------------------------------------
# Vite (VITE_*) and Next.js (NEXT_PUBLIC_*) inline these into the JS bundle when
# the image is BUILT. Setting them only at runtime does nothing — the bundle
# already has whatever was baked in.
#
# docker-compose.prod.yml passes them as `build.args` to the app, admin and
# marketing images, reading them from the same-named variables in this file.
# The Dockerfiles fail the build when a required one is empty, so a container
# can no longer boot quietly pointing at localhost.
#
# Required to build:      VITE_API_URL, VITE_WS_URL          (packages/app)
#                         VITE_API_URL                       (packages/admin)
#                         NEXT_PUBLIC_API_URL,
#                         NEXT_PUBLIC_SITE_URL               (packages/marketing)
# Optional:               VITE_POSTHOG_KEY, VITE_POSTHOG_HOST,
#                         VITE_REVIEW_LINK, NEXT_PUBLIC_POSTHOG_KEY
#
# On Vercel these are set as project environment variables instead.
# Production values look like:
# VITE_API_URL=https://api.cityroam.co.uk
# VITE_WS_URL=wss://api.cityroam.co.uk
# NEXT_PUBLIC_API_URL=https://api.cityroam.co.uk
# NEXT_PUBLIC_SITE_URL=https://cityroam.co.uk

# ---------------------------------------------------------------------------
# Database (used by: api-http, api-ws, migrate, seed)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://cityroam:cityroam@localhost:5432/cityroam

# ---------------------------------------------------------------------------
# Redis (used by: api-http, api-ws)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# API — required for HTTP process
# ---------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Optional. Route family per marketing segment: a bare UUID for all segments,
# or {"default":"<uuid>","hen-parties":"<uuid>"}. Unset uses the only active family.
CHECKOUT_ROUTE_FAMILY_IDS=

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@yourdomain.com

# AI Guide (DeepSeek)
DEEPSEEK_API_KEY=sk-...

# S3 / CDN (stop images)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=cityroam-assets
AWS_REGION=eu-west-2
AWS_CDN_BASE_URL=https://cdn.yourdomain.com

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Auth
SESSION_SECRET=random-secret-for-jwt
COOKIE_DOMAIN=.localhost

# Completion template
REVIEW_LINK=https://g.page/r/your-google-review-link/review

# ---------------------------------------------------------------------------
# API — required for WS process (subset of above)
# ---------------------------------------------------------------------------
# DATABASE_URL, REDIS_URL, COOKIE_DOMAIN (already defined above)

# ---------------------------------------------------------------------------
# Service URLs (used by: api for CORS, redirects, emails)
# ---------------------------------------------------------------------------
# MARKETING_URL / APP_URL / ADMIN_URL are ORIGINS ONLY (scheme + host + port,
# never a path). They are compared against the browser's Origin header for
# CORS, and an Origin header never contains a path.
MARKETING_URL=http://localhost:3000
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# APP_PUBLIC_URL is the full public base of the player app INCLUDING its path
# prefix (the SPA is served under /app/ — see packages/app/vite.config.ts base
# and the router basename). Used to build the event links that go into
# confirmation emails and the checkout success response.
#   production: https://cityroam.co.uk/app
APP_PUBLIC_URL=http://localhost:5173/app

# ---------------------------------------------------------------------------
# Marketing (Next.js — packages/marketing)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_SITE_URL=https://cityroam.co.uk

# ---------------------------------------------------------------------------
# App (Vite — packages/app)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
# In production this is the API domain, not a separate port — Traefik routes
# PathPrefix(`/ws/`) on API_DOMAIN to the api-ws container (wss://api.<domain>).
VITE_WS_URL=ws://localhost:3002
VITE_POSTHOG_KEY=phc_...
VITE_REVIEW_LINK=https://g.page/r/your-google-review-link/review
# VITE_POSTHOG_HOST=https://us.i.posthog.com  (optional, has default)

# ---------------------------------------------------------------------------
# Admin (Vite — packages/admin)
# ---------------------------------------------------------------------------
# Same variable name as the app above — both read VITE_API_URL, so a single
# value serves both. Listed here so the admin's requirement is not invisible.
# VITE_API_URL=http://localhost:3001
